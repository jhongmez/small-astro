---
interface Props {
    url: string;
    name: string;
}
const { url, name } = Astro.props as Props;
const id = url.split('/').at(-2);
const imageSrc = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${id}.png`;
---

<a href={`/pokemons/${name}`} class="bg-pink-500 bg-cover rounded-md flex flex-col justify-center items-center p-2">
    <img
        src={imageSrc}
        alt={name}
        class="w-full h-40 object-contain"
    />
    <span class="text-center capitalize font-mono">
        {name}
    </span>
</a>