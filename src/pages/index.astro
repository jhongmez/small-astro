---
import MainLayout from '../layouts/MainLayout.astro';
import PokemonCard from '../components/PokemonCard.astro'
import type { IPokemonListResponse } from '../interfaces/pokemon-list.response';

const title: string = 'Pokemon Static | Inicio';
const resp = await fetch('https://pokeapi.co/api/v2/pokemon/');
const data = await resp.json() as IPokemonListResponse;

---

<MainLayout title={title}>
	<h1 class="text-3xl mb-4">
		Listado de Pokemones
	</h1>
	<hr>
	<section
		aria-label="Listado de Pokemones"
		class="grid grid-cols-1 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-5 gap-4 mt-10"
	>
		{ data.results.map( ({ name, url }) => <PokemonCard name={name} url={url} /> ) }
	</section>
</MainLayout>
